{
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/articles/sss-contribution-2025",
      "redirect": "/articles/sss-contribution-2026",
      "statusCode": 301
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
